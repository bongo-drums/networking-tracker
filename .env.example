# ============================================================================
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must never be committed.
#
# Where these come from: Neon Console -> your project.
#   Auth URL      Auth page -> Configuration tab
#   Data API URL  Postgres database -> Data API -> API tab
#   DATABASE_URL  Project Dashboard -> Connect
# ============================================================================

# ---------------------------------------------------------------------------
# Public (NEXT_PUBLIC_*) — these are compiled into the browser bundle and are
# safe to expose. They are endpoints, not credentials. Row Level Security, not
# secrecy of these URLs, is what protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-12345678.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-12345678.apirest.us-east-1.aws.neon.tech/neondb/rest/v1

# ---------------------------------------------------------------------------
# Server-only — never prefix these with NEXT_PUBLIC_ and never commit real
# values. Leaking any of these bypasses Row Level Security entirely.
# ---------------------------------------------------------------------------

# Full Postgres connection string. Used only by npm run db:migrate and the
# integration test. The application itself never uses it.
DATABASE_URL=postgresql://user:password@ep-example-12345678.us-east-1.aws.neon.tech/neondb?sslmode=require

# Only needed if you add server-side auth (route handlers / middleware).
NEON_AUTH_BASE_URL=https://ep-example-12345678.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Signs the session cookie. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-string-at-least-32-characters-long
